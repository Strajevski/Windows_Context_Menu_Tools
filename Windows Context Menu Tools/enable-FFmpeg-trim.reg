@="FFmpeg Trim"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mkv\shell\FFmpeg Trim\command]
@="\"C:\\Tools\\FFmpegTrim.bat\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mov\shell\FFmpeg Trim]
@="FFmpeg Trim"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mov\shell\FFmpeg Trim\command]
