Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mp4\shell\FFmpeg Trim]
@="FFmpeg Trim"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mp4\shell\FFmpeg Trim\command]
@="\"C:\\Tools\\FFmpegTrim.bat\" \"%1\""

